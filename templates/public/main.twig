<div class="container mt-5">
    <h3 class="mb-4
{#    text-light#}
">Добро пожаловать, {{ user.email}}!</h3>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        {% for test in tests %}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">{{ test.title }}</h5>
                        <p class="card-text">{{ test.description }}</p>
                        <a href="test.php?test_id={{ test.id }}" class="btn btn-main">Начать тест</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>